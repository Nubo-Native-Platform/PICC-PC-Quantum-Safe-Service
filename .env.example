# ==============================================================================
# PICC-PC-Quantum-Safe-Service - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# Do NOT commit '.env' or real private keys/credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# HTTP port on which the Quantum-Safe Service listens (Default: 8080)
PORT=8080

# Gin operational mode: 'release' for production, 'debug' for local development
GIN_MODE=release

# ------------------------------------------------------------------------------
# 2. Hybrid Post-Quantum Key Persistence
# ------------------------------------------------------------------------------
# Path where the hybrid (X25519 + ML-KEM-768) private key file is persisted.
# - If the file exists, the service loads it on startup.
# - If the file does not exist, the service securely generates a new keypair
#   and attempts to save it to this path for continuity across restarts.
# Keep this file strictly protected (chmod 600) and NEVER commit to git.
MLKEM_KEY_PATH=keys/mlkem_private.key

# ------------------------------------------------------------------------------
# 3. Direct Key Injection via Secret (Optional - e.g. Kubernetes / Vault)
# ------------------------------------------------------------------------------
# Alternatively, supply the keypair JSON directly via environment variable
# (useful when mounting files is inconvenient, e.g. Kubernetes Secret env injection).
# If populated, this takes precedence over MLKEM_KEY_PATH.
# Format: {"x25519_private":"<base64>","mlkem_private":"<base64>"}
# MLKEM_KEY_JSON=
